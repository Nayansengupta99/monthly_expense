# Paste your Google OAuth 2.0 Web Client ID here.
# Create it at: Google Cloud Console -> APIs & Services -> Credentials
#   -> Create Credentials -> OAuth client ID -> Web application
#   Authorized JavaScript origins: http://localhost:3000 (and your Vercel URL)
# Then restart `npm start`.
REACT_APP_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID

# Backend API base URL.
# Local dev: leave EMPTY so the CRA proxy (package.json "proxy") is used.
# Production (Vercel): set to your Render backend URL, e.g.
#   https://monthly-expense-api.onrender.com
REACT_APP_API_BASE_URL=
