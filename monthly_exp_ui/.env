# Paste your Google OAuth 2.0 Web Client ID here.
# Create it at: Google Cloud Console -> APIs & Services -> Credentials
#   -> Create Credentials -> OAuth client ID -> Web application
#   Authorized JavaScript origins: http://localhost:3000
# Then restart `npm start`.
REACT_APP_GOOGLE_CLIENT_ID=700262583496-l4olebs6glge8sasd5tn4oeeirkb2osn.apps.googleusercontent.com

# Backend API base URL. Empty = use CRA proxy for local dev.
REACT_APP_API_BASE_URL=
